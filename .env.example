# BillBook POS - Master Security & Encryption Environment Variables

# Master AES-256 Secret Key used to encrypt Customer Phone, Name, UPI/Card Ref, Settings
POS_ENCRYPTION_SECRET=ROYAL_FASHION_BILLBOOK_SECURE_KEY_2026

# AES-256-GCM Secret Key for Backup and Restore (.enc.json files)
BACKUP_ENCRYPTION_SECRET=ROYAL_FASHION_BACKUP_SUPER_SECRET_KEY_2026

# API Key for Express backend routes (localhost traffic)
POS_API_KEY=BILLBOOK_INTERNAL_LOCAL_SECRET_KEY_2026

# Backend Port (default 5000)
PORT=5000
